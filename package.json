{
  "name": "servitec",
  "version": "1.0.0",
  "private": true,
  "description": "Technical Service and Warranty System",
  "workspaces": [
    "apps/backend",
    "apps/frontend",
    "apps/admin"
  ],
  "scripts": {
    "backend": "npm run dev -w @servitec/backend",
    "frontend": "npm run dev -w @servitec/frontend",
    "admin": "npm run dev -w @servitec/admin",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\" \"npm run admin\"",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
