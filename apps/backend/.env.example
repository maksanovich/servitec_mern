PORT=6190
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/servitec
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES=1h

# SMTP settings (used for sending order progress emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=your-smtp-username@gmail.com
SMTP_FROM_NAME=Servitec notificaciones

# Twilio WhatsApp (order stage updates). Set TWILIO_WHATSAPP_ENABLED=false to disable sends.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sender: sandbox e.g. whatsapp:+14155238886, or your approved WhatsApp-enabled Twilio number
TWILIO_WHATSAPP_FROM=
# Twilio Content Template SID (e.g. HX... from Twilio Content Editor)
TWILIO_WHATSAPP_TEMPLATE_SID=
# TWILIO_WHATSAPP_ENABLED=true

# Perseo ERP (hourly sync: clients + product catalog into SpareServer)
PERSEO_API=
PERSEO_DATA_C3_APP=https://perseo-data-c3.app/api/
