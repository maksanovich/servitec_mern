{
    "name": "servitec",
    "version": "1.0.0",
    "private": true,
    "description": "Technical Service and Warranty System",
    "workspaces": [
        "apps/backend",
        "apps/frontend"
    ],
    "scripts": {
        "backend": "npm run dev -w @servitec/backend",
        "frontend": "npm run dev -w @servitec/frontend",
        "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
        "build": "npm run build -w @servitec/backend && npm run build -w @servitec/frontend",
        "start": "npm run start -w @servitec/backend",
        "install:all": "npm install"
    },
    "devDependencies": {
        "concurrently": "^8.2.2"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}